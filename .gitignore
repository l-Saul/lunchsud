# Referência: https://git-scm.com/docs/gitignore

# ─── Dependências ──────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build ───────────────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ─── Variáveis de ambiente ─────────────────────────────────
# Nunca versione segredos. Só o modelo (.env.example) entra no git.
.env*
!.env.example

# ─── Deploy ────────────────────────────────────────────────
.vercel

# ─── Supabase CLI (estado local) ───────────────────────────
supabase/.branches
supabase/.temp

# ─── Testes ────────────────────────────────────────────────
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ─── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Certificados / chaves ─────────────────────────────────
*.pem
*.key

# ─── Sistema operacional ───────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini

# ─── Editores ──────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# ─── Claude Code (config pessoal) ──────────────────────────
.claude/settings.local.json
